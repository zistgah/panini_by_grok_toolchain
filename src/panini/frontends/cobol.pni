MODULE PANINI.Frontend.COBOL
FUNCTION run_cobol(source)
    RETURN feRun(source, "PANINI.Frontend.COBOL")
END
FUNCTION main()
    r = run_cobol("COMPUTE N = 40 + 2")
    RETURN r.value
END
END
