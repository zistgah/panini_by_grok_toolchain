MODULE PANINI.Frontend.SysML
FUNCTION run_sysml(source)
    RETURN feRun(source, "PANINI.Frontend.SysML")
END
FUNCTION main()
    r = run_sysml("constraint def Add { 40 + 2 }")
    RETURN r.value
END
END
