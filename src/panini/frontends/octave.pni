MODULE PANINI.Frontend.Octave
FUNCTION run_octave(source)
    RETURN feRun(source, "PANINI.Frontend.Octave")
END
FUNCTION main()
    r = run_octave("function r = add(a, b)" + NEWLINE() + "  r = a + b;" + NEWLINE() + "end")
    RETURN r.value
END
END
