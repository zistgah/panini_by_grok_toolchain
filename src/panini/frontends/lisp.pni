MODULE PANINI.Frontend.CommonLisp
FUNCTION run_lisp(source)
    r = sxRun(source, "PANINI.Frontend.CommonLisp")
    RETURN r
END
FUNCTION main()
    r = run_lisp("(+ 1 2)")
    RETURN r.value
END
END
