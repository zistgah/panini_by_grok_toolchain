/* PANINI.Frontend.Cppp — C preprocessor + eval of the expansion.
 * Copyright (C) 1993-2026 Abhishek Choudhary | GPL-3.0-or-later
 * ppCpp lives in preprocess.pni; run_c is the C evaluator.
 */
MODULE PANINI.Frontend.Cppp
FUNCTION run_cppp(source)
    r = run_c(source)
    r.frontend = "PANINI.Frontend.Cppp"
    RETURN r
END
FUNCTION main()
    r = run_cppp("#define A 42" + NEWLINE() + "int main(){return A;}" + NEWLINE())
    RETURN r.value
END
END
