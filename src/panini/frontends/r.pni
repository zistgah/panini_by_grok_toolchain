MODULE PANINI.Frontend.R
FUNCTION run_r(source)
    RETURN feRun(source, "PANINI.Frontend.R")
END
FUNCTION main()
    r = run_r("add <- function(a, b) { a + b }")
    RETURN r.value
END
END
