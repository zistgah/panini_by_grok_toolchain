MODULE PANINI.Frontend.Java
FUNCTION run_java(source)
    IF CONTAINS(source, "(int)") AND CONTAINS(source, "=")
        RETURN {ok: FALSE, rejected: "paren-cast-assign", frontend: "PANINI.Frontend.Java"}
    END
    lowered = javaToC(source)
    r = run_c(lowered)
    r.frontend = "PANINI.Frontend.Java"
    r.lowered = lowered
    RETURN r
END
FUNCTION main()
    r = run_java("class T { void f() {} }")
    RETURN r.value
END
END
