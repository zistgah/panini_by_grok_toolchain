MODULE PANINI.Frontend.Clojure
FUNCTION run_clojure(source)
    RETURN sxRun(source, "PANINI.Frontend.Clojure")
END
FUNCTION main()
    r = run_clojure("(+ 1 2)")
    RETURN r.value
END
END
