MODULE PANINI.Frontend.Go

FUNCTION gIsDigit(ch)
    RETURN ch >= "0" AND ch <= "9"
END

FUNCTION gIsAlpha(ch)
    RETURN (ch >= "A" AND ch <= "Z") OR (ch >= "a" AND ch <= "z") OR ch == "_"
END

FUNCTION gTok(kind, value)
    RETURN {kind: kind, value: value}
END

FUNCTION gLex(source)
    tokens = []
    i = 0
    n = LEN(source)
    WHILE i < n
        ch = source[i]
        IF ch == " " OR ch == TAB() OR ch == NEWLINE() OR ch == CR()
            i = i + 1
        ELSE
            IF ch == "/" AND i + 1 < n AND source[i + 1] == "/"
                WHILE i < n AND source[i] != NEWLINE()
                    i = i + 1
                END
            ELSE
                IF gIsDigit(ch)
                    raw = ""
                    WHILE i < n AND gIsDigit(source[i])
                        raw = raw + source[i]
                        i = i + 1
                    END
                    APPEND(tokens, gTok("NUM", raw))
                ELSE
                    IF gIsAlpha(ch)
                        raw = ""
                        WHILE i < n AND (gIsAlpha(source[i]) OR gIsDigit(source[i]))
                            raw = raw + source[i]
                            i = i + 1
                        END
                        kind = "IDENT"
                        IF raw == "package" OR raw == "func" OR raw == "main" OR raw == "fmt" OR raw == "Println" OR raw == "return"
                            kind = "KW"
                        END
                        APPEND(tokens, gTok(kind, raw))
                    ELSE
                        APPEND(tokens, gTok("OP", ch))
                        i = i + 1
                    END
                END
            END
        END
    END
    APPEND(tokens, gTok("EOF", ""))
    RETURN tokens
END

FUNCTION gNew(tokens)
    RETURN {tokens: tokens, i: 0}
END

FUNCTION gPeek(st)
    IF st.i >= LEN(st.tokens)
        RETURN gTok("EOF", "")
    END
    RETURN st.tokens[st.i]
END

FUNCTION gEat(st)
    t = gPeek(st)
    st.i = st.i + 1
    RETURN t
END

FUNCTION gParseAtom(st)
    t = gPeek(st)
    IF t.kind == "NUM"
        gEat(st)
        RETURN {op: "const", value: INT(t.value)}
    END
    IF t.value == "("
        gEat(st)
        e = gParseExpr(st)
        IF gPeek(st).value == ")"
            gEat(st)
        END
        RETURN e
    END
    gEat(st)
    RETURN {op: "const", value: 0}
END

FUNCTION gParseMul(st)
    left = gParseAtom(st)
    WHILE gPeek(st).value == "*" OR gPeek(st).value == "/"
        op = gEat(st).value
        left = {op: "bin", operator: op, left: left, right: gParseAtom(st)}
    END
    RETURN left
END

FUNCTION gParseExpr(st)
    left = gParseMul(st)
    WHILE gPeek(st).value == "+" OR gPeek(st).value == "-"
        op = gEat(st).value
        left = {op: "bin", operator: op, left: left, right: gParseMul(st)}
    END
    RETURN left
END

FUNCTION gEval(e)
    IF e.op == "const"
        RETURN e.value
    END
    IF e.op == "bin"
        l = gEval(e.left)
        r = gEval(e.right)
        IF e.operator == "+"
            RETURN l + r
        END
        IF e.operator == "-"
            RETURN l - r
        END
        IF e.operator == "*"
            RETURN l * r
        END
        RETURN l / r
    END
    RETURN 0
END

FUNCTION run_go(source)
    tokens = gLex(source)
    lowered = goToC(source)
    r = run_c(lowered)
    r.frontend = "PANINI.Frontend.Go"
    r.go_tokens = LEN(tokens)
    r.lowered = lowered
    RETURN r
END

FUNCTION main()
    r = run_go("package main\nfunc main(){ fmt.Println(40+2) }")
    RETURN r.value
END

END
