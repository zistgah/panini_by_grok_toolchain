MODULE PANINI.Frontend.Scheme
FUNCTION run_scheme(source)
    RETURN sxRun(source, "PANINI.Frontend.Scheme")
END
FUNCTION main()
    r = run_scheme("(+ 1 2)")
    RETURN r.value
END
END
