MODULE PANINI.Frontend.PHP
FUNCTION run_php(source)
    RETURN feRun(source, "PANINI.Frontend.PHP")
END
FUNCTION main()
    r = run_php("function add($a, $b) { return $a + $b; }")
    RETURN r.value
END
END
