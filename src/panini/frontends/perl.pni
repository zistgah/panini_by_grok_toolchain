MODULE PANINI.Frontend.Perl
FUNCTION run_perl(source)
    RETURN feRun(source, "PANINI.Frontend.Perl")
END
FUNCTION main()
    r = run_perl("sub add { return 42; }")
    RETURN r.value
END
END
