MODULE PANINI.Frontend.OCaml
FUNCTION run_ocaml(source)
    RETURN feRun(source, "PANINI.Frontend.OCaml")
END
FUNCTION main()
    r = run_ocaml("let add a b = a + b")
    RETURN r.value
END
END
